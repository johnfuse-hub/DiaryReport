# -------------------------------------------------------------
# ไฟล์ตั้งค่าค่าเริ่มต้นของระบบแจ้งเตือน LINE (Default Configuration)
# กรอกค่าไว้ที่นี่เพื่อให้ระบบจำค่าไว้เป็น Default ตลอดไป
# -------------------------------------------------------------

# ใส่ LINE Channel Access Token ที่ได้จาก LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=

# ใส่ LINE User ID / Group ID หรือพิมพ์ broadcast
LINE_USER_ID=broadcast
